# Copy to .env and adjust as needed. Existing shell variables take precedence.

# auto: ModelScope first when installed, then Hugging Face.
# modelscope / huggingface force a single source.
MODEL_SOURCE=auto
MODEL_ID=inclusionAI/Ming-3.0-tts-tiny
MODEL_PATH=./models/Ming-3.0-tts-tiny
# MODEL_REVISION=main

# GPUS=0,1,2,3          # explicit GPU list; empty means all detected GPUs
# GPU_COUNT=4           # alternative: use the first N GPUs
GATEWAY_PORT=8081
WORKER_BASE_PORT=8091
MIN_FREE_VRAM_MB=19000
STARTUP_TIMEOUT=900

# Web access password. Leave empty (default) to disable authentication.
# When set, the studio, API, uploads and library require this password.
# Restart with ./stop.sh && ./start.sh after changing it.
STUDIO_PASSWORD=
# Login session lifetime in hours. Default 24.
# STUDIO_SESSION_HOURS=24

# Gateway health probing. HEALTH_INTERVAL is the gap between worker probes;
# a worker already marked ready is re-probed every READY_RECHECK_CYCLES cycles
# (~30s by default) so a restarted worker stops receiving traffic while loading.
# HEALTH_INTERVAL=5
# READY_RECHECK_CYCLES=6

# Hugging Face mirror and access token (optional).
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=hf_xxx

# UPLOAD_DIR=./uploads
