# Keep shell scripts LF even when the repo is cloned on Windows — CRLF makes
# them fail inside WSL with "\r: command not found". Windows scripts stay CRLF
# so cmd.exe is happy. Binaries are never touched.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.wav binary
*.png binary
*.gif binary
*.jpg binary
*.webp binary
*.onnx binary
*.safetensors binary
